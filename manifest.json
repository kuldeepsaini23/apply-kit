{
  "manifest_version": 3,
  "name": "Apply Kit",
  "version": "1.2.0",
  "description": "Fills job application forms from my profile, attaches my resume, scores the job and logs applications. Never submits.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Apply Kit"
  },
  "commands": {
    "fill-form": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Fill the application form on this page"
    },
    "ai-fill-form": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Fill, then let Claude answer the open questions"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:4777/*",
        "http://127.0.0.1:4777/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  }
}